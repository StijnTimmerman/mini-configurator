{
  "version": 1,
  "name": "Lounge Chair",
  "model": { "src": "chair.glb" },
  "locale": "en-US",
  "currency": "EUR",
  "basePrice": 499,
  "scene": {
    "camera": { "position": [2.1, 1.5, 2.7], "target": [0, 0.6, 0], "fov": 38 },
    "environment": "room",
    "background": "transparent",
    "shadow": true,
    "autoRotate": false
  },
  "finish": { "default": "matte", "applyTo": ["frame"] },
  "parts": [
    {
      "id": "frame",
      "label": "Frame",
      "match": ["frame"],
      "default": "walnut",
      "options": [
        { "id": "walnut", "label": "Walnut", "texture": { "map": "textures/walnut.png", "repeat": [1, 1] } },
        { "id": "oak", "label": "Oak", "texture": { "map": "textures/oak.png", "repeat": [1, 1] }, "price": 40 },
        { "id": "black", "label": "Black", "color": "#1d1d20" },
        { "id": "chalk", "label": "Chalk", "color": "#ece9f0", "price": 20 }
      ]
    },
    {
      "id": "seat",
      "label": "Seat & backrest",
      "match": ["seat", "backrest"],
      "default": "charcoal",
      "options": [
        { "id": "charcoal", "label": "Charcoal", "color": "#3a3a40", "texture": { "map": "textures/weave.png", "repeat": [3, 3] }, "finish": false },
        { "id": "sand", "label": "Sand", "color": "#d8c4a0", "texture": { "map": "textures/weave.png", "repeat": [3, 3] }, "finish": false },
        { "id": "terracotta", "label": "Terracotta", "color": "#bf5f45", "texture": { "map": "textures/weave.png", "repeat": [3, 3] }, "price": 25, "finish": false },
        { "id": "ocean", "label": "Ocean", "color": "#3f6f8f", "texture": { "map": "textures/weave.png", "repeat": [3, 3] }, "price": 25, "finish": false },
        { "id": "forest", "label": "Forest", "color": "#39513f", "texture": { "map": "textures/weave.png", "repeat": [3, 3] }, "price": 25, "finish": false }
      ]
    },
    {
      "id": "cushion",
      "label": "Seat cushion",
      "match": ["cushion"],
      "optional": true,
      "defaultVisible": true,
      "price": 60,
      "default": "sand",
      "options": [
        { "id": "sand", "label": "Sand", "color": "#e9e1d2", "texture": { "map": "textures/weave.png", "repeat": [3, 3] }, "finish": false },
        { "id": "ocean", "label": "Ocean", "color": "#3f6f8f", "texture": { "map": "textures/weave.png", "repeat": [3, 3] }, "price": 15, "finish": false }
      ]
    }
  ],
  "quote": {
    "url": "https://example.com/quote",
    "fields": ["name", "email", "message"],
    "screenshot": true
  }
}
